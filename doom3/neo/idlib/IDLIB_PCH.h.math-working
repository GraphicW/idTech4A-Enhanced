// doom3/neo/idlib/IDLIB_PCH.h
// Minimal compatibility precompiled header replacement for idlib.

#ifndef IDLIB_PCH_H
#define IDLIB_PCH_H

// ===========================================================================
// Standard headers
// ===========================================================================

#include <cstdint>
#include <cstdarg>
#include <cstdio>
#include <cstring>
#include <cassert>
#include <cmath>
#include <cfloat>
#include <cstdlib>

// ===========================================================================
// Compiler compatibility
// ===========================================================================

#ifndef ID_INLINE
#if defined(_MSC_VER)
#define ID_INLINE __forceinline
#elif defined(__GNUC__) || defined(__clang__)
#define ID_INLINE inline __attribute__((always_inline))
#else
#define ID_INLINE inline
#endif
#endif

#ifndef id_attribute
#define id_attribute(x)
#endif

// ===========================================================================
// Basic idlib types
// ===========================================================================

#ifndef IDLIB_BASIC_TYPES_DEFINED
#define IDLIB_BASIC_TYPES_DEFINED

typedef unsigned char       byte;
typedef unsigned short      word;
typedef unsigned int        dword;
typedef unsigned long long  qword;

#endif

// ===========================================================================
// Platform compatibility
// ===========================================================================

#ifndef CPUID_NONE
#define CPUID_NONE 0
#endif

#if defined(_MSC_VER)

#include <malloc.h>

#ifndef _alloca16
#define _alloca16(x) _alloca(x)
#endif

#else

#include <alloca.h>

#ifndef _alloca16
#define _alloca16(x) alloca(x)
#endif

#endif

// ===========================================================================
// Legacy helpers
//
// Old Doom 3 code frequently expects global Min() / Max() to exist via Lib.h.
// Pulling Lib.h in here drags in a large dependency chain, so provide a
// lightweight compatibility shim instead.
// ===========================================================================

#ifndef IDLIB_PCH_MINMAX_DEFINED
#define IDLIB_PCH_MINMAX_DEFINED

template< class T >
ID_INLINE T Max(T x, T y) {
    return (x > y) ? x : y;
}

template< class T >
ID_INLINE T Min(T x, T y) {
    return (x < y) ? x : y;
}

#endif

// ===========================================================================
// Math foundation
// ===========================================================================

#pragma push_macro("i")
#pragma push_macro("a")

#ifdef i
#undef i
#endif

#ifdef a
#undef a
#endif

#include "math/Math.h"

#pragma pop_macro("a")
#pragma pop_macro("i")

// ===========================================================================
// Core idlib math support
// ===========================================================================

#include "Heap.h"

#include "math/Random.h"
#include "math/Simd.h"
#include "math/Vector.h"
#include "math/Matrix.h"
#include "math/Rotation.h"
#include "math/Plane.h"

#include "bv/Sphere.h"
#include "bv/Bounds.h"

// ===========================================================================
// Forward declarations
// ===========================================================================

class idStr;

template< typename T >
class idList;

// ===========================================================================
// Minimal idStr compatibility helpers
// ===========================================================================

#ifndef use_idStr_vsnPrintf
#define use_idStr_vsnPrintf(buf, size, fmt, ap) \
    vsnprintf((buf), (size), (fmt), (ap))
#endif

#ifndef use_idStr_snPrintf
#define use_idStr_snPrintf(buf, size, fmt, ...) \
    snprintf((buf), (size), (fmt), __VA_ARGS__)
#endif

#ifndef use_idStr_Cmpn
#define use_idStr_Cmpn(a, b, n) \
    strncmp((a), (b), (n))
#endif

#endif // IDLIB_PCH_H