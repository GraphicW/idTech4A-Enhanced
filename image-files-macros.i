			x[j] = c[j][i];
		}

		mat.LU_Solve(x, x, 0);

		for (j = 0; j < this->values.Num(); j++) {
			c[j][i] = x[j];
		}
	}

	for (i = 0; i < this->values.Num() - 1; i++) {
		c0 = 1.0f / d0[i];
		b[i] = c0 * (this->values[i + 1] - this->values[i]) - (1.0f / 3.0f) * (c[i+1] + 2.0f * c[i]) * d0[i];
		d[i] = (1.0f / 3.0f) * c0 * (c[i + 1] - c[i]);
