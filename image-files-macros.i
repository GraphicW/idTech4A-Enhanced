	}
	if( m2 > m0 )
	{
		m0 = m2;
	}

	const int s0 = 128 / 2 - 1;
	const int s1 = 128 / 4 - 1;

	int scale = 1 + ( m0 <= s0 ) + 2 * ( m0 <= s1 );

