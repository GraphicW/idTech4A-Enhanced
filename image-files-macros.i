{
	float s = (float)(t - this->TimeForIndex(index)) / (this->TimeForIndex(index+1) - this->TimeForIndex(index));
	bvals[0] = ((2.0f * s - 3.0f) * s) * s + 1.0f;				
	bvals[1] = ((-2.0f * s + 3.0f) * s) * s;					
	bvals[2] = ((s - 2.0f) * s) * s + s;						
	bvals[3] = ((s - 1.0f) * s) * s;							
}








