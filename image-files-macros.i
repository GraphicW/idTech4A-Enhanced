bool Image_WriteGeneratedFile( const char *binaryFileName, const bimageFile_t &fileData )
{
	idFile *file = fileSystem->OpenFileWrite( binaryFileName, "fs_basepath" );
	if( file == 0 )
	{
		idLib::Warning( "idBinaryImage: Could not open file '%s'", binaryFileName );
		return false;
	}
	Sys_Printf( "Writing %s: %ix%i\n", binaryFileName, fileData.width, fileData.height );

	
	

	file->WriteInt( BigLong(fileData.sourceFileTime) );
	file->WriteInt( BigLong(fileData.headerMagic) );
	file->WriteInt( BigLong(fileData.textureType) );
	file->WriteInt( BigLong(fileData.format) );
	file->WriteInt( BigLong(fileData.colorFormat) );
	file->WriteInt( BigLong(fileData.width) );
	file->WriteInt( BigLong(fileData.height) );
	file->WriteInt( BigLong(fileData.numLevels) );

	for( int i = 0; i < fileData.numLevels; i++ )
	{
		bimageImage_t& img = fileData.images[ i ];
		file->WriteInt( BigLong(img.level) );
		file->WriteInt( BigLong(img.destZ) );
		file->WriteInt( BigLong(img.width) );
		file->WriteInt( BigLong(img.height) );
		file->WriteInt( BigLong(img.dataSize) );
		file->Write( img.data, img.dataSize );
	}
	fileSystem->CloseFile(file);
	return true;
}








